# Docker's public HTTP port. HTTPS is required for geolocation on real phones.
APP_PORT=3001
APP_BIND=127.0.0.1
# Set the exact public HTTPS origin when running behind a reverse proxy.
# PUBLIC_URL=https://meet.example.com
# Trust one reverse proxy; only enable behind a trusted proxy.
TRUST_PROXY=0
# Optional map provider configuration (raster XYZ tiles).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_MAX_ZOOM=19
# Custom tile providers must also set their required attribution.
# MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
# For local Node runs; Compose uses its named volume instead.
DATABASE_PATH=./data/onmyway.sqlite
